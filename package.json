{
  "name": "litho",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Litho desktop application",
  "author": "Kareem Elbahrawy <kareem@kareemelbahrawy.com>",
  "homepage": "https://lithoapp.com",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "postinstall": "electron-rebuild -o better-sqlite3 -f",
    "lint": "biome check .",
    "format": "biome check --fix .",
    "test": "vitest run",
    "icons": "electron-icon-builder --input=resources/icon.png --output=build --flatten && cp build/icons/icon.icns build/icon.icns && cp build/icons/icon.ico build/icon.ico && cp build/icons/1024x1024.png build/icon.png && rm -rf build/icons",
    "install:mac": "rm -rf /Applications/Litho.app && hdiutil info 2>/dev/null | grep -B 10 Litho | grep /dev/disk | awk '{print $1}' | xargs -I {} hdiutil detach {} -force 2>/dev/null; cp -R dist/mac-arm64/Litho.app /Applications/ && open /Applications/Litho.app",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --x64 --arm64 --publish never",
    "dist:all": "electron-vite build && electron-builder --mac --win --publish never",
    "release:mac": "electron-vite build && electron-builder --mac --publish always",
    "release:win": "electron-vite build && electron-builder --win --x64 --arm64 --publish always",
    "release:all": "electron-vite build && electron-builder --mac --win --publish always"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "2.0.65",
    "@ai-sdk/openai": "2.0.89",
    "@ai-sdk/openai-compatible": "1.0.32",
    "@base-ui/react": "^1.2.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@esbuild/win32-x64": "0.25.12",
    "@floating-ui/core": "^1.7.5",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@jridgewell/resolve-uri": "^3.1.2",
    "@lobehub/icons": "^5.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-use-rect": "^1.1.1",
    "@radix-ui/rect": "^1.1.1",
    "@sentry-internal/browser-utils": "^10.42.0",
    "@sentry-internal/feedback": "^10.42.0",
    "@sentry-internal/replay": "^10.42.0",
    "@sentry-internal/replay-canvas": "^10.42.0",
    "@sentry/electron": "^7.8.0",
    "@sentry/react": "^10.39.0",
    "@tailwindcss/node": "^4.1.10",
    "acorn": "^8.16.0",
    "acorn-import-attributes": "^1.9.5",
    "ai": "5.0.124",
    "better-sqlite3": "^12.6.2",
    "cjs-module-lexer": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "detect-node-es": "^1.1.0",
    "electron-updater": "^6.6.2",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "^0.25.0",
    "get-nonce": "^1.0.1",
    "highlight.js": "^11.11.1",
    "input-otp": "^1.4.2",
    "json-schema": "^0.4.0",
    "jszip": "^3.10.1",
    "lightningcss-win32-x64-msvc": "1.31.1",
    "lucide-react": "^0.525.0",
    "marked": "^17.0.3",
    "marked-highlight": "^2.2.3",
    "markstream-react": "0.0.20-beta.7",
    "mimic-response": "^4.0.0",
    "ms": "^2.1.3",
    "mustache": "^4.2.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.1",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.71.1",
    "react-remove-scroll-bar": "^2.3.8",
    "react-resizable-panels": "^4.6.4",
    "react-spinners": "^0.17.0",
    "react-style-singleton": "^2.2.3",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "undici-types": "^7.22.0",
    "use-callback-ref": "^1.3.3",
    "use-sidecar": "^1.1.3",
    "vaul": "^1.1.2",
    "wrappy": "^1.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@biomejs/biome": "^2.3.15",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.0.3",
    "@sentry/vite-plugin": "^4.9.1",
    "@tailwindcss/vite": "^4.1.10",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.9",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "electron"
    ],
    "patchedDependencies": {
      "@ai-sdk/openai@2.0.89": "patches/@ai-sdk__openai@2.0.89.patch"
    }
  }
}
