{
  "name": "litho",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Litho desktop application",
  "author": "Kareem Elbahrawy <kareem@kareemelbahrawy.com>",
  "homepage": "https://lithoapp.com",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "postinstall": "electron-rebuild -o better-sqlite3",
    "lint": "biome check .",
    "format": "biome check --fix .",
    "test": "vitest run",
    "icons": "electron-icon-builder --input=resources/icon.png --output=build --flatten && cp build/icons/icon.icns build/icon.icns && cp build/icons/icon.ico build/icon.ico && cp build/icons/1024x1024.png build/icon.png && rm -rf build/icons"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "2.0.65",
    "@ai-sdk/openai": "2.0.89",
    "@ai-sdk/openai-compatible": "1.0.32",
    "@base-ui/react": "^1.2.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/electron": "^7.8.0",
    "@sentry/react": "^10.39.0",
    "@sentry/vite-plugin": "^4.9.1",
    "@tailwindcss/node": "^4.1.10",
    "ai": "5.0.124",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.6.2",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.11.1",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.525.0",
    "marked": "^17.0.3",
    "marked-highlight": "^2.2.3",
    "markstream-react": "0.0.20-beta.7",
    "mustache": "^4.2.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.1",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^4.6.4",
    "react-spinners": "^0.17.0",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/vite": "^4.1.10",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.9",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "electron"
    ],
    "patchedDependencies": {
      "@ai-sdk/openai@2.0.89": "patches/@ai-sdk__openai@2.0.89.patch"
    }
  }
}
