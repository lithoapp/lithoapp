function ColorScale({
  name,
  role,
  colors,
}: {
  name: string;
  role: string;
  colors: { shade: string; hex: string; className: string }[];
}) {
  return (
    <div className="rounded-2xl bg-neutral-900 border border-neutral-800 p-5">
      <div className="flex items-center justify-between mb-4">
        <p className="font-mono text-sm text-secondary-300 uppercase tracking-widest">{name}</p>
        <p className="font-mono text-xs text-neutral-500">{role}</p>
      </div>
      <div className="grid grid-cols-11 gap-2">
        {colors.map((color) => (
          <div key={color.shade} className="min-w-0">
            <div className={`h-14 rounded-md ${color.className} ring-1 ring-white/10`} />
            <p className="mt-1.5 font-mono text-[10px] text-neutral-500 text-center">{color.shade}</p>
          </div>
        ))}
      </div>
    </div>
  );
}

function HeroColorCard({
